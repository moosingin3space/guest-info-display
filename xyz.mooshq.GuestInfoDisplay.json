{
  "$schema": "https://raw.githubusercontent.com/flatpak/flatpak-builder/main/data/flatpak-manifest.schema.json",
  "id": "xyz.mooshq.GuestInfoDisplay",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "guest-info-display",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--device=dri",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio"
  ],
  "modules": [
    {
      "name": "app",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/app/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo build --offline --release",
        "install -Dm0755 target/release/guest-info-display -t ${FLATPAK_DEST}/bin/",
        "install -Dm0644 data/${FLATPAK_ID}.metainfo.xml -t ${FLATPAK_DEST}/share/metainfo/",
        "install -Dm0644 data/${FLATPAK_ID}.desktop -t ${FLATPAK_DEST}/share/applications/",
        "install -Dm0644 data/${FLATPAK_ID}.svg -t ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "./"
        },
        "generated-sources.json"
      ]
    }
  ]
}
